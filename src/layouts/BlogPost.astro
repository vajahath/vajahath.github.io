---
import RemoteImage from "../components/RemoteImage.astro";
import { parseDimensionsFromUrl } from "../lib/wsrv";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import SeriesNav from "../components/SeriesNav.astro";
import TableOfContents from "../components/TableOfContents.astro";

import { TAGS, type TagKey } from "../consts";
import TagChip from "../components/TagChip.astro";
import HalftoneField from "../components/HalftoneField.astro";
import { splitOnHighlight } from "../lib/highlight";

type Props = CollectionEntry<"blog">["data"] & {
	series?: {
		title: string;
		slug: string;
		currentOrder: number;
		totalParts: number;
		prevPost?: { id: string; title: string };
		nextPost?: { id: string; title: string };
	};
	headings?: MarkdownHeading[];
};

const {
	title,
	titleHighlight,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	tags = [],
	hotTakes = [],
	toc,
	series,
	headings = [],
} = Astro.props;

const showToc = (toc === true || toc === "show") && headings.length > 0;
const imageDims = heroImage ? parseDimensionsFromUrl(heroImage) : {};
const hasImageDims = imageDims.width !== undefined && imageDims.height !== undefined;
// A tag only gets a link if it's registered; unregistered ones have no tag
// page to point at, so they render as plain chips instead of dead links.
const tagMetadata = tags.map((t: string) => ({
	...(TAGS[t as TagKey] ?? { label: t, color: "#000", textColor: "#fff" }),
	registered: t in TAGS,
}));

const displayTitle = title;
const titleParts = splitOnHighlight(displayTitle, titleHighlight);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body
		class="bg-white text-black dark:bg-black dark:text-white transition-colors duration-200"
	>
		<Header />

		{/* overflow-x-clip, not hidden: the decorative screens bleed past the
		    container between 1024 and 1366px, and `hidden` would make this a
		    scroll container and break the sticky table of contents. */}
		<main class="relative overflow-x-clip max-w-7xl mx-auto px-4 py-8">
			<HalftoneField
				class="hidden lg:block absolute -left-24 top-16 w-72 h-72"
				cell={13}
				hue={20}
				opacity={45}
			/>
			<HalftoneField
				class="hidden lg:block absolute -right-20 top-[38rem] w-64 h-64"
				cell={15}
				hue={-60}
				opacity={38}
			/>
			<div class:list={["relative", showToc && "flex items-start gap-12 justify-center"]}>
			<article class={showToc ? "max-w-2xl w-full flex flex-col gap-6 min-w-0" : "max-w-2xl mx-auto flex flex-col gap-6"}>
				{/* Top Meta */}
				<div
					class="flex flex-wrap items-center gap-4 m3-label-medium text-black dark:text-white"
				>
					<div class="flex flex-wrap gap-2">
						{
							tagMetadata.map((tag: any) => (
								<TagChip
									label={tag.label}
									color={tag.color}
									textColor={tag.textColor}
									variant="solid"
									href={
										tag.registered
											? `/tags/${tag.label
													.toLowerCase()
													.replace(/\s+/g, "-")}`
											: undefined
									}
								/>
							))
						}
						{
							series && (
								<a
									href={`/series/${series.slug}/`}
									class="m3-label-medium uppercase tracking-wider px-2 py-1 bg-signal-fill text-white transition-opacity hover:opacity-80"
								>
									Series · Part {series.currentOrder}
								</a>
							)
						}
					</div>
					<span>By {author}</span>
					<span class="text-black/30 dark:text-white/30">•</span>
					<span><FormattedDate date={pubDate} /></span>
					{
						updatedDate && (
							<span class="italic text-signal-text">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>

				{/* Article Title */}
				<div class="flex flex-col gap-4">
					<h1 class="m3-display-large text-black dark:text-white">
						{titleParts.before}
						{titleParts.marked && (
							<span class="mark mark-signal">{titleParts.match}</span>
						)}
						{titleParts.after}
					</h1>

					{/* The "Lede" */}
					<p class="m3-lede mb-6">
						{description}
					</p>

					{
						hotTakes.length > 0 && (
							<div class="news-signal-highlight">
								<HalftoneField
									class="absolute -right-16 -bottom-14 w-36 h-36"
									cell={11}
									hue={15}
									opacity={55}
								/>
								<h2 class="relative m3-label-medium mb-3 uppercase tracking-[0.3em] text-signal-text font-black">
									Signal Highlights
								</h2>
								<ul class="relative list-none space-y-2.5">
									{hotTakes.map((take: string) => (
										<li class="m3-body-large flex gap-4 items-start">
											<span class="text-signal-text text-xl leading-none mt-0.5">
												/
											</span>
											<span class="font-medium">
												{take}
											</span>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</div>

				<div class="w-full h-0.5 bg-black/10 dark:bg-white/10 my-1">
				</div>

				{/* Hero Image */}
				{
					heroImage && (
						hasImageDims ? (
							<div
								class="w-full overflow-hidden bg-gray-100 dark:bg-zinc-800"
								style={`aspect-ratio: ${imageDims.width} / ${imageDims.height};`}
							>
								<RemoteImage
									src={heroImage}
									alt={title}
									width={imageDims.width!}
									height={imageDims.height!}
									loading="eager"
									fetchpriority="high"
									sizes="(max-width: 768px) 100vw, 1200px"
									class="w-full h-full object-cover"
								/>
							</div>
						) : (
							<div class="w-full overflow-hidden">
								<RemoteImage
									src={heroImage}
									alt={title}
									width={1200}
									height={675}
									loading="eager"
									fetchpriority="high"
									sizes="(max-width: 768px) 100vw, 1200px"
									natural={true}
								/>
							</div>
						)
					)
				}

				{/* Article Body */}
				<div
					class="prose prose-neutral dark:prose-invert max-w-none m3-body-large [&>p]:mb-5 [&>h1]:m3-display-small [&>h1]:mt-16 [&>h1]:mb-6 [&>h2]:m3-headline-medium [&>h2]:mt-14 [&>h2]:mb-4 [&>h2]:border-b-2 [&>h2]:border-black dark:[&>h2]:border-white [&>h2]:pb-1 [&>h3]:m3-headline-small [&>h3]:mt-8 [&>h3]:mb-3 [&>h4]:m3-title-large [&>h4]:mt-6 [&>h4]:mb-2 [&>blockquote]:border-l-4 [&>blockquote]:border-signal [&>blockquote]:bg-gray-50 dark:[&>blockquote]:bg-zinc-950 [&>blockquote]:p-6 [&>blockquote]:italic [&>blockquote]:font-bold [&>blockquote]:text-xl [&>pre]:rounded-none [&>pre]:border [&>pre]:border-black dark:[&>pre]:border-white [&>pre]:p-6 [&>ul]:list-square [&>li]:mb-2 [&>img]:h-auto [&>img]:max-w-full"
				>
					<slot />
				</div>

				{series && <SeriesNav {...series} />}
			</article>
			{showToc && <TableOfContents headings={headings} />}
			</div>
		</main>

		<Footer />
		<style is:global>
			@reference "../styles/global.css";

			.prose a {
				@apply text-signal-text font-black underline decoration-2 underline-offset-4 hover:bg-signal-text hover:text-white transition-all;
			}

			.prose strong {
				font-variation-settings:
					"wght" 900,
					"wdth" 100;
				font-weight: 900;
			}

			.prose .heading-anchor {
				opacity: 0;
				margin-left: 0.4em;
				font-size: 0.75em;
				font-weight: 400;
				text-decoration: none;
				color: var(--color-signal);
				transition: opacity 0.15s;
				vertical-align: middle;
			}

			.prose h2:hover .heading-anchor,
			.prose h3:hover .heading-anchor,
			.prose h4:hover .heading-anchor {
				opacity: 1;
			}
		</style>
		<script>
			document.querySelectorAll<HTMLHeadingElement>('.prose h2[id], .prose h3[id], .prose h4[id]').forEach((heading) => {
				const anchor = document.createElement('a');
				anchor.href = `#${heading.id}`;
				anchor.className = 'heading-anchor';
				anchor.setAttribute('aria-label', 'Link to this section');
				anchor.textContent = '#';
				heading.appendChild(anchor);
			});
		</script>
	</body>
</html>
