---
import RemoteImage from "../components/RemoteImage.astro";
import { parseDimensionsFromUrl } from "../lib/wsrv";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import SeriesNav from "../components/SeriesNav.astro";
import TableOfContents from "../components/TableOfContents.astro";

import { TAGS, type TagKey } from "../consts";

type Props = CollectionEntry<"blog">["data"] & {
	series?: {
		title: string;
		slug: string;
		currentOrder: number;
		totalParts: number;
		prevPost?: { id: string; title: string };
		nextPost?: { id: string; title: string };
	};
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	tags = [],
	hotTakes = [],
	toc,
	series,
	headings = [],
} = Astro.props;

const showToc = (toc === true || toc === "show") && headings.length > 0;
const imageDims = heroImage ? parseDimensionsFromUrl(heroImage) : {};
const hasImageDims = imageDims.width !== undefined && imageDims.height !== undefined;
const tagMetadata = tags.map(
	(t: string) =>
		TAGS[t as TagKey] || { label: t, color: "#000", textColor: "#fff" },
);

const displayTitle = title;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body
		class="bg-white text-black dark:bg-black dark:text-white transition-colors duration-200"
	>
		<Header />

		<main class="max-w-7xl mx-auto px-4 py-8">
			<div class={showToc ? "flex items-start gap-12 justify-center" : ""}>
			<article class={showToc ? "max-w-2xl w-full flex flex-col gap-6 min-w-0" : "max-w-2xl mx-auto flex flex-col gap-6"}>
				{/* Top Meta */}
				<div
					class="flex flex-wrap items-center gap-4 m3-label-medium text-black dark:text-white"
				>
					<div class="flex flex-wrap gap-2">
						{
							tagMetadata.map((tag: any) => (
								<a
									href={`/tags/${tag.label
										.toLowerCase()
										.replace(/\s+/g, "-")}`}
									class="px-2 py-0.5 font-black uppercase tracking-wider transition-opacity hover:opacity-80 border border-black/10"
									style={`background-color: ${tag.color}; color: ${tag.textColor};`}
								>
									{tag.label}
								</a>
							))
						}
						{
							series && (
								<a
									href={`/series/${series.slug}/`}
									class="px-2 py-0.5 font-black uppercase tracking-wider bg-live-red text-white transition-opacity hover:opacity-80 border border-black/10"
								>
									Series · Part {series.currentOrder}
								</a>
							)
						}
					</div>
					<span>By {author}</span>
					<span class="text-black/30 dark:text-white/30">•</span>
					<span><FormattedDate date={pubDate} /></span>
					{
						updatedDate && (
							<span class="italic text-live-red">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>

				{/* Article Title */}
				<div class="flex flex-col gap-4">
					<h1 class="m3-display-large text-black dark:text-white">
						{displayTitle}
					</h1>

					{/* The "Lede" */}
					<p class="m3-lede">
						{description}
					</p>

					{
						hotTakes.length > 0 && (
							<div class="news-signal-highlight">
								<h3 class="m3-label-medium mb-3 uppercase tracking-[0.3em] text-live-red font-black">
									Signal Highlights
								</h3>
								<ul class="list-none space-y-2.5">
									{hotTakes.map((take: string) => (
										<li class="m3-body-large flex gap-4 items-start">
											<span class="text-live-red text-xl leading-none mt-0.5">
												/
											</span>
											<span class="font-medium">
												{take}
											</span>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</div>

				<div class="w-full h-0.5 bg-black/10 dark:bg-white/10 my-1">
				</div>

				{/* Hero Image */}
				{
					heroImage && (
						hasImageDims ? (
							<div
								class="w-full overflow-hidden bg-gray-100 dark:bg-zinc-800"
								style={`aspect-ratio: ${imageDims.width} / ${imageDims.height};`}
							>
								<RemoteImage
									src={heroImage}
									alt={title}
									width={imageDims.width!}
									height={imageDims.height!}
									loading="eager"
									sizes="(max-width: 768px) 100vw, 1200px"
									class="w-full h-full object-cover"
								/>
							</div>
						) : (
							<div class="w-full overflow-hidden bg-gray-100 dark:bg-zinc-800">
								<RemoteImage
									src={heroImage}
									alt={title}
									width={1200}
									height={675}
									loading="eager"
									sizes="(max-width: 768px) 100vw, 1200px"
									natural={true}
								/>
							</div>
						)
					)
				}

				{/* Article Body */}
				<div
					class="prose prose-neutral dark:prose-invert max-w-none m3-body-large [&>p]:mb-6 [&>h1]:m3-display-small [&>h1]:mt-12 [&>h1]:mb-6 [&>h2]:m3-headline-medium [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:border-b-2 [&>h2]:border-black dark:[&>h2]:border-white [&>h2]:pb-1 [&>h3]:m3-headline-small [&>h3]:mt-8 [&>h3]:mb-3 [&>blockquote]:border-l-4 [&>blockquote]:border-brand-blue [&>blockquote]:bg-gray-50 dark:[&>blockquote]:bg-zinc-950 [&>blockquote]:p-6 [&>blockquote]:italic [&>blockquote]:font-bold [&>blockquote]:text-xl [&>pre]:rounded-none [&>pre]:border [&>pre]:border-black dark:[&>pre]:border-white [&>pre]:p-6 [&>ul]:list-square [&>li]:mb-2 [&>img]:border-0 [&>img]:h-auto [&>img]:max-w-full"
				>
					<slot />
				</div>

				{series && <SeriesNav {...series} />}
			</article>
			{showToc && <TableOfContents headings={headings} />}
			</div>
		</main>

		<Footer />
		<style is:global>
			@reference "../styles/global.css";

			.prose a {
				@apply text-brand-blue font-black underline decoration-2 underline-offset-4 hover:bg-brand-blue hover:text-white transition-all;
			}

			.prose strong {
				font-variation-settings:
					"wght" 900,
					"wdth" 100;
				font-weight: 900;
			}

			.prose .heading-anchor {
				opacity: 0;
				margin-left: 0.4em;
				font-size: 0.75em;
				font-weight: 400;
				text-decoration: none;
				color: var(--color-brand-blue);
				transition: opacity 0.15s;
				vertical-align: middle;
			}

			.prose h2:hover .heading-anchor,
			.prose h3:hover .heading-anchor,
			.prose h4:hover .heading-anchor {
				opacity: 1;
			}
		</style>
		<script>
			document.querySelectorAll<HTMLHeadingElement>('.prose h2[id], .prose h3[id], .prose h4[id]').forEach((heading) => {
				const anchor = document.createElement('a');
				anchor.href = `#${heading.id}`;
				anchor.className = 'heading-anchor';
				anchor.setAttribute('aria-label', 'Link to this section');
				anchor.textContent = '#';
				heading.appendChild(anchor);
			});
		</script>
	</body>
</html>
