---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// Use the title as-is (letting CSS handle casing for Capital Case/Uppercase)
const displayTitle = title;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body
		class="bg-white text-black dark:bg-black dark:text-gray-100 transition-colors duration-200"
	>
		<Header />

		<main class="max-w-7xl mx-auto px-4 py-8">
			<article class="max-w-2xl mx-auto flex flex-col gap-6">
				{/* Top Meta */}
				<div
					class="flex items-center gap-4 m3-label-medium text-gray-500 dark:text-gray-400"
				>
					<span class="tag-accent">Report</span>
					<span><FormattedDate date={pubDate} /></span>
					{
						updatedDate && (
							<span class="italic text-live-red">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>

				{/* Article Title */}
				<div class="flex flex-col gap-4">
					<h1 class="m3-display-large text-black dark:text-white">
						{displayTitle}
					</h1>

					{/* The "Lede" */}
					<p
						class="m3-title-large text-gray-700 dark:text-gray-300 italic border-l-4 border-black dark:border-white pl-6"
					>
						{description}
					</p>
				</div>

				<div class="w-full h-0.5 bg-black/10 dark:bg-white/10 my-1">
				</div>

				{/* Hero Image */}
				{
					heroImage && (
						<div class="w-full aspect-video overflow-hidden bg-gray-100 dark:bg-zinc-800 border-2 border-black dark:border-white">
							<Image
								width={1200}
								height={675}
								src={heroImage}
								alt={title}
								class="w-full h-full object-cover grayscale brightness-110 contrast-125 dark:grayscale-0 dark:brightness-90"
								loading="eager"
							/>
						</div>
					)
				}

				{/* Article Body */}
				<div
					class="prose prose-neutral dark:prose-invert max-w-none m3-body-large [&>p]:mb-6 [&>h2]:m3-headline-large [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:border-b-2 [&>h2]:border-black dark:[&>h2]:border-white [&>h2]:pb-1 [&>h3]:m3-title-large [&>h3]:mt-8 [&>h3]:mb-3 [&>blockquote]:border-l-4 [&>blockquote]:border-brand-blue [&>blockquote]:bg-gray-50 dark:[&>blockquote]:bg-zinc-950 [&>blockquote]:p-6 [&>blockquote]:italic [&>blockquote]:font-bold [&>blockquote]:text-xl [&>pre]:rounded-none [&>pre]:border [&>pre]:border-black dark:[&>pre]:border-white [&>pre]:p-6 [&>ul]:list-square [&>li]:mb-2 [&>img]:border-2 [&>img]:border-black dark:[&>img]:border-white"
				>
					<slot />
				</div>
			</article>
		</main>

		<Footer />
		<style is:global>
			@reference "../styles/global.css";

			.prose a {
				@apply text-brand-blue font-black underline decoration-2 underline-offset-4 hover:bg-brand-blue hover:text-white transition-all;
			}

			.prose strong {
				font-variation-settings: "wght" 900;
				font-weight: 900;
			}
		</style>
	</body>
</html>
