---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import NewsItem from "../components/NewsItem.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Function to convert string to Title Case
function toTitleCase(str: string) {
	return str.replace(
		/\w\S*/g,
		(txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase()
	);
}

const breakingPost = posts[0];
const feedPosts = posts.slice(1, 4);
const sidebarPosts = posts.slice(4, 9);
const focusPost = posts[9] || posts[0];

const focusTitle = focusPost ? toTitleCase(focusPost.data.title) : "";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | News Portal`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body
		class="bg-white text-black dark:bg-black dark:text-gray-100 transition-colors duration-200"
	>
		<Header />

		<main class="max-w-7xl mx-auto px-4 py-8">
			{/* Breaking News Hero Section */}
			{
				breakingPost && (
					<section class="pb-10 mb-10 border-b-2 border-black dark:border-white">
						<NewsItem post={breakingPost} type="hero" />
					</section>
				)
			}

			<div class="grid lg:grid-cols-3 gap-12">
				{/* Main Content Feed (2/3) */}
				<div class="lg:col-span-2 flex flex-col">
					<h3
						class="m3-label-medium text-gray-500 dark:text-gray-400 mb-6 flex items-center gap-2 uppercase tracking-[0.2em]"
					>
						<span class="w-3 h-3 bg-brand-blue"></span>
						Latest Updates
					</h3>
					<div class="flex flex-col">
						{
							feedPosts.map((post) => (
								<NewsItem post={post} type="standard" />
							))
						}
					</div>
				</div>

				{/* Sidebar Content (1/3) */}
				<aside
					class="space-y-12 border-t lg:border-t-0 lg:border-l-2 border-black/10 dark:border-white/10 lg:pl-10 pt-10 lg:pt-0"
				>
					{/* Just In Feed */}
					<section>
						<h3
							class="m3-label-medium mb-6 flex items-center gap-2 uppercase tracking-[0.2em]"
						>
							<span
								class="w-2.5 h-2.5 bg-live-green rounded-full animate-pulse"
							></span>
							Just In
						</h3>
						<div class="space-y-6">
							{
								sidebarPosts.map((post) => (
									<NewsItem post={post} type="sidebar-item" />
								))
							}
						</div>
					</section>

					{/* Focus Section */}
					{
						focusPost && (
							<section class="p-8 bg-gray-50 dark:bg-zinc-950 border-l-8 border-brand-blue">
								<h3 class="m3-label-medium mb-6 uppercase tracking-[0.2em]">
									Focus
								</h3>
								<p class="m3-focus-title italic mb-4 leading-tight">
									"{focusTitle}"
								</p>

								<p class="m3-body-large text-gray-600 dark:text-gray-400 mb-6 font-medium">
									{focusPost.data.description}
								</p>
								<a
									href={`/blog/${focusPost.id}/`}
									class="m3-touch-target inline-flex items-center m3-label-medium text-brand-blue hover:bg-brand-blue hover:text-white px-6 py-2 border-2 border-brand-blue transition-all"
								>
									Read Analysis →
								</a>
							</section>
						)
					}
				</aside>
			</div>
		</main>

		<Footer />
	</body>
</html>
