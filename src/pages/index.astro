---
import RemoteImage from "../components/RemoteImage.astro";
import { parseDimensionsFromUrl } from "../lib/wsrv";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import NewsItem from "../components/NewsItem.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// --- CONFIGURATION ---
const FEED_POSTS_COUNT = 6;
const HOT_TAKES_COUNT = 5;
// ---------------------

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Function to convert string to Title Case
function toTitleCase(str: string) {
	return str.replace(
		/\w\S*/g,
		(txt) => txt.charAt(0).toUpperCase() + txt.slice(1).toLowerCase()
	);
}

// 1. Explicitly fetch Spotlight and Focus news
const spotlightPost = posts.find((p) => p.data.isSpotlight) || posts[0];

// Exclude spotlight post from candidates for Focus to avoid duplication
const focusOptions = posts.filter((p) => p.id !== spotlightPost?.id);
const focusPost =
	focusOptions.find((p) => p.data.isFocus) ||
	focusOptions[8] ||
	focusOptions[0];

// 2. Prepare remaining posts for the main feed
const assignedIds = new Set([spotlightPost?.id, focusPost?.id].filter(Boolean));
const remainingPosts = posts.filter((p) => !assignedIds.has(p.id));

const feedPosts = remainingPosts.slice(0, FEED_POSTS_COUNT);

const focusTitle = focusPost ? toTitleCase(focusPost.data.title) : "";
const focusImageDims = focusPost?.data.heroImage ? parseDimensionsFromUrl(focusPost.data.heroImage) : {};
const focusHasDims = focusImageDims.width !== undefined && focusImageDims.height !== undefined;

// 3. Hot Takes Logic
const hotTakesList = posts
	.filter((p) => Array.isArray(p.data.hotTakes) && p.data.hotTakes.length > 0)
	.flatMap((p) =>
		(p.data.hotTakes || []).map((take) => ({
			text: take,
			postId: p.id,
		}))
	)
	.sort(() => Math.random() - 0.5)
	.slice(0, HOT_TAKES_COUNT);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | News Portal`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body
		class="bg-white text-black dark:bg-black dark:text-white transition-colors duration-200"
	>
		<Header />

		<main class="max-w-7xl mx-auto px-4 py-8">
			<!-- Spotlight Hero Section -->
			{
				spotlightPost && (
					<section class="pb-10 mb-10 border-b-2 border-black dark:border-white">
						<NewsItem post={spotlightPost} type="hero" />
					</section>
				)
			}

			<div class="grid lg:grid-cols-3 gap-12">
				<!-- Main Content Feed (2/3) -->
				<div class="lg:col-span-2 flex flex-col">
					<h3
						class="m3-label-medium text-black dark:text-white mb-6 flex items-center gap-2 uppercase tracking-[0.2em]"
					>
						<span class="w-3 h-3 bg-black dark:bg-white"></span>
						Latest Updates
					</h3>
					<div class="flex flex-col">
						{
							feedPosts.map((post) => (
								<NewsItem post={post} type="standard" />
							))
						}
					</div>
				</div>

				<!-- Sidebar Content (1/3) -->
				<aside
					class="space-y-12 border-t lg:border-t-0 lg:border-l-2 border-black/10 dark:border-white/10 lg:pl-10 pt-10 lg:pt-0"
				>
					<!-- Hot Takes Feed -->
					<section>
						<h3
							class="m3-label-medium mb-6 flex items-center gap-2 uppercase tracking-[0.2em]"
						>
							<span class="w-2.5 h-2.5 bg-live-red rounded-full"
							></span>
							Hot Takes
						</h3>
						<div class="flex flex-col gap-8">
							{
								hotTakesList.map((take) => (
									<div class="group relative">
										<p class="m3-title-large text-xl italic leading-tight mb-2">
											{take.text}
										</p>
										<a
											href={`/blog/${take.postId}/`}
											class="m3-label-medium text-live-red hover:underline uppercase tracking-widest text-[10px]"
										>
											Source Signal →
										</a>
									</div>
								))
							}
						</div>
					</section>

					<!-- Focus Section -->
					{
						focusPost && (
							<section class="bg-gray-50 dark:bg-zinc-950 border-2 border-black dark:border-white overflow-hidden">
								{focusPost.data.heroImage && (
									focusHasDims ? (
										<div
											class="w-full overflow-hidden"
											style={`aspect-ratio: ${focusImageDims.width} / ${focusImageDims.height};`}
										>
											<RemoteImage
												src={focusPost.data.heroImage}
												alt={focusPost.data.title}
												width={focusImageDims.width!}
												height={focusImageDims.height!}
												sizes="100vw"
												class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
											/>
										</div>
									) : (
										<div class="w-full overflow-hidden">
											<RemoteImage
												src={focusPost.data.heroImage}
												alt={focusPost.data.title}
												width={800}
												height={450}
												sizes="100vw"
												natural={true}
											/>
										</div>
									)
								)}
								<div class="p-8">
									<h3 class="m3-label-medium mb-6 uppercase tracking-[0.2em] text-brand-blue">
										Focus Analysis
									</h3>
									<p class="m3-focus-title italic mb-4 leading-tight text-2xl font-black">
										{focusTitle}
									</p>

									<p class="m3-body-large text-black dark:text-white mb-6 font-medium line-clamp-4">
										{focusPost.data.description}
									</p>
									<a
										href={`/blog/${focusPost.id}/`}
										class="m3-touch-target inline-flex items-center m3-label-medium text-black dark:text-white hover:underline px-6 py-2 border-2 border-black dark:border-white transition-all uppercase tracking-widest"
									>
										Read Full Analysis →
									</a>
								</div>
							</section>
						)
					}
				</aside>
			</div>
		</main>

		<Footer />
	</body>
</html>
