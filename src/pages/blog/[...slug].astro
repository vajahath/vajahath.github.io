---
import { getVisiblePosts } from "../../lib/content";
import {
	type CollectionEntry,
	getEntry,
	render,
} from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;

// Series Logic
const seriesId = post.data.seriesId;
const isInSeries = seriesId != null && post.data.seriesOrder != null;

let seriesData: any = undefined;
if (isInSeries) {
	const allPosts = await getVisiblePosts();
	const seriesPosts = allPosts
		.filter(
			(p) =>
				p.data.seriesId === seriesId && p.data.seriesOrder != null,
		)
		.sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));

	const currentIndex = seriesPosts.findIndex((p) => p.id === post.id);
	const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
	const nextPost =
		currentIndex < seriesPosts.length - 1
			? seriesPosts[currentIndex + 1]
			: null;

	const seriesMeta = await getEntry("series", seriesId);

	if (seriesMeta) {
		seriesData = {
			title: seriesMeta.data.title,
			slug: seriesId,
			currentOrder: post.data.seriesOrder!,
			totalParts: seriesPosts.length,
			prevPost: prevPost
				? { id: prevPost.id, title: prevPost.data.title }
				: undefined,
			nextPost: nextPost
				? { id: nextPost.id, title: nextPost.data.title }
				: undefined,
		};
	}
}

const { Content, headings } = await render(post);
---

<BlogPost {...post.data} series={seriesData} headings={headings}>
	<Content />
</BlogPost>
