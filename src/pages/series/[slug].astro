---
import { getVisiblePosts, getVisibleSeries } from "../../lib/content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_TITLE } from "../../consts";
import RemoteImage from "../../components/RemoteImage.astro";

export async function getStaticPaths() {
    const series = await getVisibleSeries();
    return series.map((s) => ({
        params: { slug: s.id },
        props: { series: s },
    }));
}

const { series } = Astro.props;
const posts = await getVisiblePosts();
const seriesPosts = posts
    .filter(
        (p) => p.id.startsWith(series.id + "/") && p.data.seriesOrder != null,
    )
    .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${SITE_TITLE} | ${series.data.title}`}
            description={series.data.description}
        />
    </head>
    <body
        class="bg-white text-black dark:bg-black dark:text-white transition-colors duration-200"
    >
        <Header />
        <main class="max-w-7xl mx-auto px-4 py-12">
            {/* Series Header */}
            <section class="grid lg:grid-cols-2 gap-12 mb-16 items-center">
                <div class="flex flex-col gap-6">
                    <div class="flex items-center gap-2">
                        <span
                            class="m3-label-medium bg-signal-fill text-white px-2 py-0.5 font-black uppercase tracking-widest"
                        >
                            Full Narrative Series
                        </span>
                    </div>
                    <h1
                        class="text-6xl md:text-8xl font-black uppercase tracking-tighter italic leading-none"
                    >
                        {series.data.title}
                    </h1>
                    <p class="m3-lede italic text-black/70 dark:text-white/70">
                        {series.data.description}
                    </p>
                    {
                        series.data.startedAt && (
                            <div class="m3-label-medium font-black">
                                Commenced:{" "}
                                <FormattedDate date={series.data.startedAt} />
                            </div>
                        )
                    }
                </div>
                {
                    series.data.coverImage && (
                        <div class="aspect-video bg-gray-100 dark:bg-zinc-800 overflow-hidden border-2 border-black dark:border-white">
                            <RemoteImage
                                src={series.data.coverImage}
                                alt={series.data.title}
                                width={1200}
                                height={675}
                                sizes="(max-width: 1024px) 100vw, 50vw"
                                loading="eager"
                                fetchpriority="high"
                                class="w-full h-full object-cover"
                            />
                        </div>
                    )
                }
            </section>

            {/* TOC List */}
            <section class="max-w-3xl">
                <h2
                    class="m3-label-medium mb-8 flex items-center gap-2 uppercase tracking-[0.2em] border-b-2 border-black dark:border-white pb-2"
                >
                    <span class="w-3 h-3 bg-signal"></span>
                    Timeline of Events
                </h2>
                <div class="flex flex-col">
                    {
                        seriesPosts.map((post) => (
                            <a
                                href={`/blog/${post.id}/`}
                                class="group flex gap-6 py-8 border-b border-black/10 dark:border-white/10 hover:bg-signal/5 transition-colors px-4 -mx-4 items-center"
                            >
                                <div class="flex flex-col items-center shrink-0 min-w-[3rem]">
                                    <span class="m3-label-medium opacity-70">
                                        PART
                                    </span>
                                    <span class="text-4xl font-black italic">
                                        {post.data.seriesOrder}
                                    </span>
                                </div>
                                <div class="flex flex-col flex-1 gap-1">
                                    <h3 class="m3-title-large group-hover:text-signal-text group-hover:underline decoration-2 underline-offset-4">
                                        {post.data.title}
                                    </h3>
                                    <p class="m3-body-large text-sm opacity-70 line-clamp-1">
                                        {post.data.description}
                                    </p>
                                </div>
                                <div class="shrink-0 text-right hidden sm:block">
                                    <span class="m3-label-medium opacity-70 block">
                                        STATUS
                                    </span>
                                    <span class="m3-label-medium font-black text-signal-text">
                                        PUBLISHED
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>

                <div class="mt-12">
                    <a
                        href={`/blog/${seriesPosts[0]?.id}/`}
                        class="inline-block bg-black text-white dark:bg-white dark:text-black px-8 py-4 m3-label-large font-black hover:bg-signal-text dark:hover:bg-signal dark:hover:text-white transition-colors"
                    >
                        Start Reading Narrative →
                    </a>
                </div>
            </section>
        </main>
        <Footer />
    </body>
</html>
