---
import { getVisiblePosts } from "../lib/content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import NewsItem from "../components/NewsItem.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const RECENT_POSTS_LIMIT = 20;

const posts = (await getVisiblePosts()).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = posts.slice(0, RECENT_POSTS_LIMIT);

// Grouping logic for the sidebar archive
const groupedPosts = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	const month = post.data.pubDate.toLocaleString("en-US", { month: "long" });
	if (!acc[year]) acc[year] = {};
	if (!acc[year][month]) acc[year][month] = [];
	acc[year][month].push(post);
	return acc;
}, {} as Record<number, Record<string, any[]>>);

const years = Object.keys(groupedPosts)
	.map(Number)
	.sort((a, b) => b - a);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | Archives`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body
		class="bg-white text-black dark:bg-black dark:text-white transition-colors duration-200"
	>
		<Header />
		<main class="max-w-7xl mx-auto px-4 py-12">
			<section
				class="border-b-4 border-black dark:border-white pb-12 mb-12"
			>
				<h1
					class="text-6xl md:text-9xl font-black uppercase tracking-tighter italic leading-none"
				>
					Archives
				</h1>
				<p
					class="text-sm font-bold uppercase tracking-[0.4em] mt-4 text-black dark:text-white"
				>
					Categorized_Signals_Repository
				</p>
			</section>

			<div class="grid lg:grid-cols-3 gap-12 items-start">
				<!-- Main Column (Recent Posts) -->
				<section class="lg:col-span-2 flex flex-col">
					<h2
						class="m3-label-medium mb-8 flex items-center gap-2 uppercase tracking-[0.2em]"
					>
						<span class="w-3 h-3 bg-black dark:bg-white"></span>
						Recent Signals
					</h2>
					<div class="flex flex-col">
						{
							recentPosts.map((post) => (
								<NewsItem post={post} type="standard" />
							))
						}
					</div>
				</section>

				<!-- Sidebar (Historical Archive) -->
				<aside class="space-y-12">
					<h2
						class="m3-label-medium mb-8 flex items-center gap-2 uppercase tracking-[0.2em]"
					>
						<span class="w-3 h-3 bg-live-red"></span>
						Deep Archive
					</h2>
					<div class="space-y-10">
						{
							years.map((year) => (
								<div class="space-y-6">
									<h3 class="m3-display-large text-4xl border-b-2 border-black/10 dark:border-white/10 pb-2">
										{year}
									</h3>
									<div class="space-y-8 pl-4">
										{Object.keys(groupedPosts[year])
											.sort(
												(a, b) =>
													new Date(
														`${b} 1, ${year}`
													).getTime() -
													new Date(
														`${a} 1, ${year}`
													).getTime()
											)
											.map((month) => (
												<div class="space-y-3">
													<h4 class="m3-label-medium text-live-red-text tracking-widest">
														{month.toUpperCase()}
													</h4>
													<ul class="space-y-2 border-l border-black/5 dark:border-white/5 pl-4">
														{groupedPosts[year][
															month
														].map((post) => (
															<li>
																<a
																	href={`/blog/${post.id}/`}
																	class="m3-body-large text-base hover:text-brand-blue-text hover:underline leading-tight block"
																>
																	{
																		post
																			.data
																			.title
																	}
																</a>
															</li>
														))}
													</ul>
												</div>
											))}
									</div>
								</div>
							))
						}
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
