---
import { getVisiblePosts } from "../../lib/content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NewsItem from "../../components/NewsItem.astro";
import { SITE_TITLE, SITE_DESCRIPTION, TAGS, type TagKey } from "../../consts";

export async function getStaticPaths() {
    const posts = await getVisiblePosts();
    const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

    return tags.map((tag) => ({
        params: { tag: tag.toLowerCase().replace(/\s+/g, "-") },
        props: {
            tagName: tag,
            posts: posts
                .filter((post) => post.data.tags?.includes(tag))
                .sort(
                    (a, b) =>
                        b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
                ),
        },
    }));
}

const { tagName, posts } = Astro.props;
const metadata = TAGS[tagName as TagKey] || {
    color: "#000",
    textColor: "#fff",
};
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <BaseHead
            title={`${tagName} | ${SITE_TITLE}`}
            description={`${SITE_DESCRIPTION} - ${tagName}`}
        />
    </head>
    <body
        class="bg-white text-black dark:bg-black dark:text-white transition-colors duration-200"
    >
        <Header />
        <main class="max-w-7xl mx-auto px-4 py-12">
            <section
                class="border-b-4 border-black dark:border-white pb-12 mb-12 flex flex-col items-start gap-4"
            >
                <span
                    class="m3-label-medium text-black dark:text-white uppercase tracking-widest px-1"
                    >Tag_Archives</span
                >
                <h1 class="m3-display-large italic leading-none flex items-center gap-4">
                    <span
                        class="w-5 h-5 rounded-full shrink-0"
                        style={`background-color: ${metadata.color};`}
                    />
                    {tagName}
                </h1>
            </section>

            <div class="grid lg:grid-cols-3 gap-x-12 gap-y-0">
                {/* Main Column (2/3) */}
                <div
                    class="lg:col-span-2 divide-y-2 divide-black dark:divide-white"
                >
                    {
                        posts
                            .slice(0, Math.ceil(posts.length * 0.6))
                            .map((post: any) => (
                                <NewsItem post={post} type="standard" headingLevel={2} />
                            ))
                    }
                </div>

                {/* Sidebar Column (1/3) */}
                <aside
                    class="space-y-0 divide-y-2 divide-black/10 dark:divide-white/10 border-t lg:border-t-0 lg:border-l-2 border-black/10 dark:border-white/10 lg:pl-10 pt-10 lg:pt-0"
                >
                    {
                        posts
                            .slice(Math.ceil(posts.length * 0.6))
                            .map((post: any) => (
                                <NewsItem post={post} type="standard" headingLevel={2} />
                            ))
                    }
                </aside>
            </div>
        </main>
        <Footer />
    </body>
</html>
