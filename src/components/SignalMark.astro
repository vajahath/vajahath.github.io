---
/**
 * Four rising bars — a signal meter, weak on the left. The site is called
 * Faint Signals and its copy is all transmission and noise; this is the mark
 * that lets the design say so too, and it replaces the anonymous black square
 * and red dot that used to head each section.
 *
 * Decorative: the heading beside it already carries the meaning.
 */
interface Props {
	class?: string;
	/** Bars drawn at full strength; the rest sit faint behind them. */
	strength?: 1 | 2 | 3 | 4;
}
const { class: className = '', strength = 2 } = Astro.props;
const bars = [0.3, 0.52, 0.76, 1];
---

<svg
	class:list={['shrink-0', className]}
	viewBox="0 0 16 14"
	width="16"
	height="14"
	aria-hidden="true"
	focusable="false"
>
	{
		bars.map((h, i) => (
			<rect
				x={i * 4.2}
				y={14 - h * 14}
				width="2.8"
				height={h * 14}
				fill="currentColor"
				opacity={i < strength ? 1 : 0.28}
			/>
		))
	}
</svg>
