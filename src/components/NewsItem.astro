---
import RemoteImage from "./RemoteImage.astro";
import { parseDimensionsFromUrl } from "../lib/wsrv";
import FormattedDate from "./FormattedDate.astro";
import { TAGS, type TagKey } from "../consts";
import TagChip from "./TagChip.astro";
import HalftoneField from "./HalftoneField.astro";
import { splitOnHighlight, markInkClass } from "../lib/highlight";

interface Props {
    post: any;
    type?: "hero" | "standard" | "sidebar-item";
    className?: string;
    /** Row title level. Must sit exactly one below the section heading above
     *  it, or the page outline skips a level. */
    headingLevel?: 2 | 3 | 4;
}

const {
    post,
    type = "standard",
    className = "",
    headingLevel = 3,
} = Astro.props;
const RowHeading = `h${headingLevel}` as const;

// Function to convert string to Title Case
function toTitleCase(str: string) {
    return str.replace(
        /\w\S*/g,
        (txt) => txt.charAt(0).toUpperCase() + txt.slice(1).toLowerCase(),
    );
}

const title = toTitleCase(post.data.title);
// Title-casing rewrites the string, so the fragment has to be matched after it.
const titleParts = splitOnHighlight(title, post.data.titleHighlight);
const titleInk = markInkClass(post.data.titleHighlightColor);
const tags = post.data.tags || [];
const tagMetadata = tags.map(
    (t: string) =>
        TAGS[t as TagKey] || { label: t, color: "#000", textColor: "#fff" },
);

// Row metadata stays one line tall once the row has room, so only the first few
// chips are shown. Below the 500px container breakpoint it wraps instead —
// chips plus a nowrap date simply do not fit a phone, and forcing them to
// scrolled the whole page sideways.
const MAX_ROW_CHIPS = 3;
const rowTags = tagMetadata.slice(0, MAX_ROW_CHIPS);
const overflowTagCount = tagMetadata.length - rowTags.length;

// Series Logic
const segments = post.id.split("/");
const isInSeries = segments.length > 1 && post.data.seriesOrder != null;
const seriesOrder = post.data.seriesOrder;
const imageDims = post.data.heroImage ? parseDimensionsFromUrl(post.data.heroImage) : {};
const hasImageDims = imageDims.width !== undefined && imageDims.height !== undefined;

// Deterministic hue per post, so a row looks the same on every build but no
// two rows in a feed look alike.
const slugHue =
    ([...post.id].reduce((h: number, c: string) => (h * 31 + c.charCodeAt(0)) | 0, 7) % 360 + 360) % 360;

---

{
    type === "hero" && (
        <div class:list={["flex flex-col gap-6 @container/hero", className]}>
            <div class="flex items-center gap-2.5 text-signal-text">
                <span class="m3-label-medium tracking-[0.25em] uppercase">
                    Spotlight
                </span>
            </div>
            <div
                class={`grid ${
                    post.data.heroImage
                        ? "grid-cols-1 @[600px]/hero:grid-cols-2"
                        : "grid-cols-1"
                } gap-8 items-start`}
            >
                <div class="order-2 @[600px]/hero:order-1">
                    <a href={`/blog/${post.id}/`} class="group m3-touch-target">
                        <h2 class="m3-display-medium mb-4 text-black dark:text-white">
                            {titleParts.before}
                            {titleParts.marked && (
                                <span class:list={["mark", titleInk]}>{titleParts.match}</span>
                            )}
                            {titleParts.after}
                        </h2>
                    </a>
                    <p class="m3-body-large text-black dark:text-white mb-6 line-clamp-3">
                        {post.data.description}
                    </p>
                    <div class="flex flex-wrap gap-2 mb-6">
                        {tagMetadata.map((tag: any) => (
                            <TagChip
                                label={tag.label}
                                color={tag.color}
                                href={`/tags/${tag.label
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")}`}
                            />
                        ))}
                        {isInSeries && (
                            <span class="m3-label-medium uppercase tracking-wider text-signal-text">
                                Series · Part {seriesOrder}
                            </span>
                        )}
                    </div>
                    <div class="flex items-center gap-4 m3-label-medium text-black dark:text-white">
                        <span class="font-bold">By {post.data.author}</span>
                        <span class="text-black/30 dark:text-white/30">•</span>
                        <span class="font-bold"><FormattedDate date={post.data.pubDate} /></span>
                    </div>
                </div>
                {post.data.heroImage && (
                    hasImageDims ? (
                        <div
                            class="order-1 @[600px]/hero:order-2 bg-gray-100 dark:bg-zinc-800 overflow-hidden"
                            style={`aspect-ratio: ${imageDims.width} / ${imageDims.height};`}
                        >
                            <RemoteImage
                                src={post.data.heroImage}
                                alt={post.data.title}
                                width={imageDims.width!}
                                height={imageDims.height!}
                                sizes="(max-width: 600px) 100vw, 600px"
                                loading="eager"
                                fetchpriority="high"
                                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                            />
                        </div>
                    ) : (
                        <div class="order-1 @[600px]/hero:order-2 overflow-hidden">
                            <RemoteImage
                                src={post.data.heroImage}
                                alt={post.data.title}
                                width={1200}
                                height={675}
                                sizes="(max-width: 600px) 100vw, 600px"
                                loading="eager"
                                fetchpriority="high"
                                natural={true}
                            />
                        </div>
                    )
                )}
            </div>
        </div>
    )
}

{
    type === "standard" && (
        <article
            class:list={[
                "py-9 group border-b border-black/12 dark:border-white/15 last:border-0 @container/standard",
                className,
            ]}
        >
            <div class="flex flex-col @[500px]:flex-row gap-6">
                <div class="flex-1 order-2 @[500px]:order-1 max-w-3xl">
                    <div class="flex flex-wrap @[500px]/standard:flex-nowrap items-center gap-2 mb-3 min-w-0">
                        {rowTags.map((tag: any) => (
                            <TagChip
                                label={tag.label}
                                color={tag.color}
                                href={`/tags/${tag.label
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")}`}
                            />
                        ))}
                        {overflowTagCount > 0 && (
                            <span class="m3-label-medium uppercase text-black/45 dark:text-white/45 shrink-0">
                                +{overflowTagCount}
                            </span>
                        )}
                        {isInSeries && (
                            <span class="m3-label-medium uppercase tracking-wider text-signal-text shrink-0">
                                Part {seriesOrder}
                            </span>
                        )}
                        <span class="m3-label-medium text-black/45 dark:text-white/45 shrink-0 whitespace-nowrap">
                            <FormattedDate date={post.data.pubDate} />
                        </span>
                    </div>
                    <a href={`/blog/${post.id}/`} class="m3-touch-target">
                        <RowHeading class="m3-headline-large mb-2.5 text-black dark:text-white">
                            {title}
                        </RowHeading>
                    </a>
                    <p class="m3-body-large text-black dark:text-white line-clamp-3">
                        {post.data.description}
                    </p>
                </div>
                {!post.data.heroImage && (
                    <div class="w-full @[500px]:w-56 aspect-video overflow-hidden shrink-0 order-1 @[500px]:order-2 border border-black/12 dark:border-white/15">
                        <HalftoneField
                            class="w-full h-full"
                            cell={9}
                            fade="none"
                            hue={slugHue}
                            opacity={80}
                        />
                    </div>
                )}
                {post.data.heroImage && (
                    <div class="w-full @[500px]:w-56 aspect-video overflow-hidden shrink-0 order-1 @[500px]:order-2 border border-black/12 dark:border-white/15">
                        <RemoteImage
                            src={post.data.heroImage}
                            alt={post.data.title}
                            width={448}
                            height={252}
                            sizes="(max-width: 500px) 100vw, 224px"
                            class="w-full h-full object-cover object-center transition-all duration-500"
                        />
                    </div>
                )}
            </div>
        </article>
    )
}

{
    type === "sidebar-item" && (
        <div
            class:list={[
                "pb-4 border-b border-black/10 dark:border-white/10 last:border-0",
                className,
            ]}
        >
            <span class="m3-label-medium text-black dark:text-white block mb-1">
                {new Date(post.data.pubDate).toLocaleTimeString("en-US", {
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false,
                })}
            </span>
            <a
                href={`/blog/${post.id}/`}
                class="m3-touch-target m3-title-large text-base text-black dark:text-white block"
            >
                {title}
            </a>
        </div>
    )
}
