---
import RemoteImage from "./RemoteImage.astro";
import { parseDimensionsFromUrl } from "../lib/wsrv";
import FormattedDate from "./FormattedDate.astro";
import { TAGS, type TagKey } from "../consts";
import { splitOnHighlight } from "../lib/highlight";

interface Props {
    post: any;
    type?: "hero" | "standard" | "sidebar-item";
    className?: string;
    /** Row title level. Must sit exactly one below the section heading above
     *  it, or the page outline skips a level. */
    headingLevel?: 2 | 3 | 4;
    /** 1-based position in the feed, shown as a circled index. */
    index?: number;
}

const {
    post,
    type = "standard",
    className = "",
    headingLevel = 3,
    index,
} = Astro.props;
const RowHeading = `h${headingLevel}` as const;

// Function to convert string to Title Case
function toTitleCase(str: string) {
    return str.replace(
        /\w\S*/g,
        (txt) => txt.charAt(0).toUpperCase() + txt.slice(1).toLowerCase(),
    );
}

const title = toTitleCase(post.data.title);
// Title-casing rewrites the string, so the fragment has to be matched after it.
const titleParts = splitOnHighlight(title, post.data.titleHighlight);
const tags = post.data.tags || [];
const tagMetadata = tags.map(
    (t: string) =>
        TAGS[t as TagKey] || { label: t, color: "#000", textColor: "#fff" },
);

// Row metadata stays one line tall once the row has room, so only the first few
// chips are shown. Below the 500px container breakpoint it wraps instead —
// chips plus a nowrap date simply do not fit a phone, and forcing them to
// scrolled the whole page sideways.
const MAX_ROW_CHIPS = 3;
const rowTags = tagMetadata.slice(0, MAX_ROW_CHIPS);
const overflowTagCount = tagMetadata.length - rowTags.length;

// Series Logic
const segments = post.id.split("/");
const isInSeries = segments.length > 1 && post.data.seriesOrder != null;
const seriesOrder = post.data.seriesOrder;
const imageDims = post.data.heroImage ? parseDimensionsFromUrl(post.data.heroImage) : {};
const hasImageDims = imageDims.width !== undefined && imageDims.height !== undefined;

// A spotlight with no hero image leaves half the page empty. The post's own
// loudest line fills that better than a placeholder image would.
const pullQuote: string | undefined =
    !post.data.heroImage && Array.isArray(post.data.hotTakes)
        ? post.data.hotTakes[0]
        : undefined;
const heroIsSplit = Boolean(post.data.heroImage || pullQuote);
---

{
    type === "hero" && (
        <div class:list={["flex flex-col gap-6 @container/hero", className]}>
            <div class="flex items-center gap-2">
                <span class="m3-label-medium text-black dark:text-white font-black tracking-widest uppercase">
                    <span class="mark mark-yellow">Spotlight</span>
                </span>
            </div>
            <div
                class={`grid ${
                    heroIsSplit
                        ? "grid-cols-1 @[600px]/hero:grid-cols-2"
                        : "grid-cols-1"
                } gap-8 items-start`}
            >
                <div class="order-2 @[600px]/hero:order-1">
                    <a href={`/blog/${post.id}/`} class="group m3-touch-target">
                        <h2 class="m3-display-medium mb-4 text-black dark:text-white">
                            {titleParts.before}
                            {titleParts.marked && (
                                <span class="mark mark-yellow">{titleParts.match}</span>
                            )}
                            {titleParts.after}
                        </h2>
                    </a>
                    <p class="m3-body-large text-black dark:text-white mb-6 line-clamp-3">
                        {post.data.description}
                    </p>
                    <div class="flex flex-wrap gap-2 mb-6">
                        {tagMetadata.map((tag: any) => (
                            <a
                                href={`/tags/${tag.label
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")}`}
                                class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider transition-opacity hover:opacity-80 border border-black/10"
                                style={`background-color: ${tag.color}; color: ${tag.textColor};`}
                            >
                                {tag.label}
                            </a>
                        ))}
                        {isInSeries && (
                            <span class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider bg-live-red-fill text-white border border-black/10">
                                Series · Part {seriesOrder}
                            </span>
                        )}
                    </div>
                    <div class="flex items-center gap-4 m3-label-medium text-black dark:text-white">
                        <span class="font-bold">By {post.data.author}</span>
                        <span class="text-black/30 dark:text-white/30">•</span>
                        <span class="font-bold"><FormattedDate date={post.data.pubDate} /></span>
                    </div>
                </div>
                {pullQuote && (
                    <aside class="order-3 @[600px]/hero:order-2 border-l-4 border-black dark:border-white pl-6 self-start">
                        <p class="m3-label-medium text-black/60 dark:text-white/60 uppercase tracking-[0.2em] mb-4">
                            From the piece
                        </p>
                        <blockquote class="m3-title-large @[600px]/hero:m3-headline-medium italic leading-tight text-black dark:text-white">
                            <span class="mark mark-pink">{pullQuote}</span>
                        </blockquote>
                    </aside>
                )}
                {post.data.heroImage && (
                    hasImageDims ? (
                        <div
                            class="order-1 @[600px]/hero:order-2 bg-gray-100 dark:bg-zinc-800 overflow-hidden"
                            style={`aspect-ratio: ${imageDims.width} / ${imageDims.height};`}
                        >
                            <RemoteImage
                                src={post.data.heroImage}
                                alt={post.data.title}
                                width={imageDims.width!}
                                height={imageDims.height!}
                                sizes="(max-width: 600px) 100vw, 600px"
                                loading="eager"
                                fetchpriority="high"
                                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                            />
                        </div>
                    ) : (
                        <div class="order-1 @[600px]/hero:order-2 overflow-hidden">
                            <RemoteImage
                                src={post.data.heroImage}
                                alt={post.data.title}
                                width={1200}
                                height={675}
                                sizes="(max-width: 600px) 100vw, 600px"
                                loading="eager"
                                fetchpriority="high"
                                natural={true}
                            />
                        </div>
                    )
                )}
            </div>
        </div>
    )
}

{
    type === "standard" && (
        <article
            class:list={[
                "py-8 group border-b-2 border-black dark:border-white last:border-0 @container/standard",
                className,
            ]}
        >
            <div class="flex flex-col @[500px]:flex-row gap-6">
                <div class="flex-1 order-2 @[500px]:order-1 max-w-3xl">
                    <div class="flex flex-wrap @[500px]/standard:flex-nowrap items-center gap-2 mb-3 min-w-0">
                        {index != null && (
                            /* Purely visual rhythm; the row order already says
                               this, so announcing a bare "01" is just noise. */
                            <span
                                aria-hidden="true"
                                class="mark-circle mark-green m3-label-medium text-black dark:text-white shrink-0"
                            >
                                {String(index).padStart(2, "0")}
                            </span>
                        )}
                        {rowTags.map((tag: any) => (
                            <a
                                href={`/tags/${tag.label
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")}`}
                                class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider transition-opacity hover:opacity-80 border border-black/10 shrink-0"
                                style={`background-color: ${tag.color}; color: ${tag.textColor};`}
                            >
                                {tag.label}
                            </a>
                        ))}
                        {overflowTagCount > 0 && (
                            <span class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider border border-black/20 dark:border-white/20 text-black/60 dark:text-white/60 shrink-0">
                                +{overflowTagCount}
                            </span>
                        )}
                        {isInSeries && (
                            <span class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider bg-live-red-fill text-white border border-black/10 shrink-0">
                                Series · Part {seriesOrder}
                            </span>
                        )}
                        <span class="m3-label-medium text-black dark:text-white ml-1 shrink-0 whitespace-nowrap">
                            <FormattedDate date={post.data.pubDate} />
                        </span>
                    </div>
                    <a href={`/blog/${post.id}/`} class="m3-touch-target">
                        <RowHeading class="m3-headline-large mb-2.5 text-black dark:text-white">
                            {title}
                        </RowHeading>
                    </a>
                    <p class="m3-body-large text-black dark:text-white line-clamp-3">
                        {post.data.description}
                    </p>
                </div>
                {post.data.heroImage && (
                    <div class="w-full @[500px]:w-56 aspect-video overflow-hidden shrink-0 order-1 @[500px]:order-2 border-2 border-black dark:border-white">
                        <RemoteImage
                            src={post.data.heroImage}
                            alt={post.data.title}
                            width={448}
                            height={252}
                            sizes="(max-width: 500px) 100vw, 224px"
                            class="w-full h-full object-cover object-center transition-all duration-500"
                        />
                    </div>
                )}
            </div>
        </article>
    )
}

{
    type === "sidebar-item" && (
        <div
            class:list={[
                "pb-4 border-b border-black/10 dark:border-white/10 last:border-0",
                className,
            ]}
        >
            <span class="m3-label-medium text-black dark:text-white block mb-1">
                {new Date(post.data.pubDate).toLocaleTimeString("en-US", {
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false,
                })}
            </span>
            <a
                href={`/blog/${post.id}/`}
                class="m3-touch-target m3-title-large text-base text-black dark:text-white block"
            >
                {title}
            </a>
        </div>
    )
}
