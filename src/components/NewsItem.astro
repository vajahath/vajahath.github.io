---
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import { TAGS, type TagKey } from "../consts";

interface Props {
    post: any;
    type?: "hero" | "standard" | "sidebar-item";
    className?: string;
}

const { post, type = "standard", className = "" } = Astro.props;

// Function to convert string to Title Case
function toTitleCase(str: string) {
    return str.replace(
        /\w\S*/g,
        (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase()
    );
}

const title = toTitleCase(post.data.title);
const tags = post.data.tags || [];
const tagMetadata = tags.map(
    (t: string) =>
        TAGS[t as TagKey] || { label: t, color: "#000", textColor: "#fff" }
);
---

{
    type === "hero" && (
        <div class:list={["flex flex-col gap-6", className]}>
            <div class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 bg-live-red rounded-full" />
                <span class="m3-label-medium text-live-red font-black tracking-widest uppercase">
                    Spotlight
                </span>
            </div>
            <div
                class={`grid ${
                    post.data.heroImage ? "md:grid-cols-2" : "grid-cols-1"
                } gap-8 items-start`}
            >
                <div class="order-2 md:order-1">
                    <a href={`/blog/${post.id}/`} class="group m3-touch-target">
                        <h2 class="m3-display-large mb-4 text-black dark:text-white">
                            {title}
                        </h2>
                    </a>
                    <p class="m3-body-large text-black dark:text-white mb-6 line-clamp-3">
                        {post.data.description}
                    </p>
                    <div class="flex flex-wrap gap-2 mb-6">
                        {tagMetadata.map((tag: any) => (
                            <a
                                href={`/tags/${tag.label
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")}`}
                                class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider transition-opacity hover:opacity-80"
                                style={`background-color: ${tag.color}; color: ${tag.textColor};`}
                            >
                                {tag.label}
                            </a>
                        ))}
                    </div>
                    <div class="flex items-center gap-4 m3-label-medium text-black dark:text-white">
                        <span class="font-bold">By Author Name</span>
                        <span class="text-black/30 dark:text-white/30">•</span>
                        <span class="font-bold">12m ago</span>
                    </div>
                </div>
                {post.data.heroImage && (
                    <div class="order-1 md:order-2 aspect-video bg-gray-100 dark:bg-zinc-800 overflow-hidden">
                        <Image
                            src={post.data.heroImage}
                            alt={post.data.title}
                            width={1200}
                            height={675}
                            class="w-full h-full object-cover grayscale brightness-110 contrast-125 dark:grayscale-0 dark:brightness-90 transition-transform duration-500 hover:scale-105"
                        />
                    </div>
                )}
            </div>
        </div>
    )
}

{
    type === "standard" && (
        <article
            class:list={[
                "py-6 group border-b-2 border-black dark:border-white last:border-0",
                className,
            ]}
        >
            <div class="flex flex-col md:flex-row gap-6">
                <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        {tagMetadata.map((tag: any) => (
                            <a
                                href={`/tags/${tag.label
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")}`}
                                class="m3-label-medium px-2 py-0.5 font-black uppercase tracking-wider transition-opacity hover:opacity-80"
                                style={`background-color: ${tag.color}; color: ${tag.textColor};`}
                            >
                                {tag.label}
                            </a>
                        ))}
                        <span class="m3-label-medium text-black dark:text-white ml-1">
                            <FormattedDate date={post.data.pubDate} />
                        </span>
                    </div>
                    <a href={`/blog/${post.id}/`} class="m3-touch-target">
                        <h4 class="m3-headline-large mb-3 text-black dark:text-white">
                            {title}
                        </h4>
                    </a>
                    <p class="m3-body-large text-black dark:text-white line-clamp-2">
                        {post.data.description}
                    </p>
                </div>
                {post.data.heroImage && (
                    <div class="w-full md:w-40 aspect-square bg-gray-100 dark:bg-zinc-800 overflow-hidden shrink-0">
                        <Image
                            src={post.data.heroImage}
                            alt={post.data.title}
                            width={400}
                            height={400}
                            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                        />
                    </div>
                )}
            </div>
        </article>
    )
}

{
    type === "sidebar-item" && (
        <div
            class:list={[
                "pb-4 border-b border-black/10 dark:border-white/10 last:border-0",
                className,
            ]}
        >
            <span class="m3-label-medium text-black dark:text-white block mb-1">
                {new Date(post.data.pubDate).toLocaleTimeString("en-US", {
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false,
                })}
            </span>
            <a
                href={`/blog/${post.id}/`}
                class="m3-touch-target m3-title-large text-base text-black dark:text-white block"
            >
                {title}
            </a>
        </div>
    )
}
