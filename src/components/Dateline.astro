---
/**
 * Newspaper dateline. Sits between the masthead and the Spotlight, where the
 * page otherwise runs to empty air, and does the job a real masthead strip
 * does: says where this is filed from, how big the archive is, and when it
 * last went to press.
 *
 * The edition number is the archive size, so it climbs on its own as posts
 * land. The date is the build date — a static site goes to press when it
 * deploys.
 */
import { getVisiblePosts } from '../lib/content';

const posts = await getVisiblePosts();
const edition = String(posts.length).padStart(2, '0');

const pressDate = new Date().toLocaleDateString('en-US', {
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<div class="max-w-7xl mx-auto px-4">
	<p
		class="m3-label-medium text-black dark:text-white flex flex-wrap items-center gap-x-5 gap-y-2 py-3 border-b-2 border-black dark:border-white"
	>
		<span class="flex items-center gap-2">
			Vol. I &middot; No.
			<span class="mark-circle mark-green">{edition}</span>
		</span>
		<span aria-hidden="true" class="opacity-30">/</span>
		<span>Kerala, India</span>
		<span aria-hidden="true" class="opacity-30">/</span>
		<span>Pressed {pressDate}</span>
		<span aria-hidden="true" class="opacity-30">/</span>
		<span class="text-black/60 dark:text-white/60">All takes provisional</span>
	</p>
</div>
