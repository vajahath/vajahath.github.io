---
import { SITE_TITLE } from "../consts";
const today = new Date();
---

<footer class="border-t border-black/10 dark:border-white/10 mt-20 py-12">
	<div class="max-w-7xl mx-auto px-4 grid md:grid-cols-4 gap-8">
		<div class="col-span-2">
			<h2
				class="m3-headline-large italic leading-none text-black dark:text-white mb-4"
			>
				{SITE_TITLE.toUpperCase()}
			</h2>
			<p class="m3-body-medium text-gray-500 max-w-md leading-relaxed">
				A digital news hub focused on the intersections of technology,
				energy, and aesthetics. Built for high performance and absolute
				legibility.
			</p>
		</div>
		<div>
			<h4 class="m3-label-medium text-black dark:text-white mb-4">
				Sections
			</h4>
			<ul class="m3-label-large space-y-2 text-black dark:text-white">
				<li>
					<a
						href="/"
						class="hover:underline opacity-80 hover:opacity-100"
						>Home</a>
				</li>
				<li>
					<a
						href="/blog"
						class="hover:underline opacity-80 hover:opacity-100"
						>Dev Logs</a>
				</li>
				<li>
					<a
						href="#"
						class="hover:underline opacity-80 hover:opacity-100"
						>Solar Energy</a>
				</li>
				<li>
					<a
						href="#"
						class="hover:underline opacity-80 hover:opacity-100"
						>Fashion Design</a>
				</li>
			</ul>
		</div>
		<div>
			<h4 class="m3-label-medium text-black dark:text-white mb-4">
				About
			</h4>
			<p class="m3-body-medium text-gray-500 italic">
				"Subject to change. Probably wrong. Frequently noted."
			</p>
		</div>
	</div>
	<div
		class="max-w-7xl mx-auto px-4 mt-12 pt-8 border-t border-black/5 dark:border-white/5 flex justify-between items-center m3-label-small text-gray-400"
	>
		<span>© {today.getFullYear()} {SITE_TITLE.toUpperCase()}</span>
		<span>All takes are my own.</span>
	</div>
</footer>
