---
export interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	filtered.length > 0 && (
		<>
			{/* Desktop sidebar */}
			<aside
				id="toc-sidebar"
				class="hidden xl:block w-64 shrink-0 sticky top-8 self-start max-h-[calc(100vh-5rem)] overflow-y-auto"
			>
				<p class="m3-label-medium uppercase tracking-[0.2em] text-black/40 dark:text-white/40 mb-4">
					On this page
				</p>
				<nav aria-label="Table of contents">
					<ul class="flex flex-col gap-1">
						{filtered.map((h) => (
							<li class={h.depth === 3 ? "pl-4" : ""}>
								<a
									href={`#${h.slug}`}
									data-toc-link={h.slug}
									class="toc-link block py-1 text-sm text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors leading-snug"
								>
									{h.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>

			{/* Mobile floating button */}
			<button
				id="toc-open"
				aria-label="Open table of contents"
				class="xl:hidden fixed right-0 bottom-12 z-40 bg-black dark:bg-white text-white dark:text-black w-8 h-14 flex items-center justify-center rounded-l-md shadow-lg"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="square"
				>
					<line x1="3" y1="6" x2="21" y2="6" />
					<line x1="3" y1="12" x2="16" y2="12" />
					<line x1="3" y1="18" x2="11" y2="18" />
				</svg>
			</button>

			{/* Mobile backdrop */}
			<div
				id="toc-backdrop"
				class="xl:hidden fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300"
			/>

			{/* Mobile drawer */}
			<div
				id="toc-drawer"
				class="xl:hidden fixed right-0 top-0 bottom-0 z-50 w-72 bg-white dark:bg-black border-l border-black/10 dark:border-white/10 translate-x-full transition-transform duration-300 flex flex-col shadow-2xl"
			>
				<div class="flex items-center justify-between p-5 border-b border-black/10 dark:border-white/10">
					<p class="m3-label-medium uppercase tracking-[0.2em] text-black/40 dark:text-white/40">
						On this page
					</p>
					<button
						id="toc-close"
						aria-label="Close table of contents"
						class="w-8 h-8 flex items-center justify-center text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
						>
							<line x1="18" y1="6" x2="6" y2="18" />
							<line x1="6" y1="6" x2="18" y2="18" />
						</svg>
					</button>
				</div>
				<nav aria-label="Table of contents" class="overflow-y-auto flex-1 p-5">
					<ul class="flex flex-col gap-1">
						{filtered.map((h) => (
							<li class={h.depth === 3 ? "pl-4" : ""}>
								<a
									href={`#${h.slug}`}
									data-toc-link={h.slug}
									class="toc-link block py-2 text-sm text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors leading-snug"
								>
									{h.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</>
	)
}

<style>
	.toc-link.active {
		color: var(--color-signal);
		font-variation-settings: "wght" 700;
	}
</style>

<script>
	const openBtn = document.getElementById("toc-open");
	const closeBtn = document.getElementById("toc-close");
	const drawer = document.getElementById("toc-drawer");
	const backdrop = document.getElementById("toc-backdrop");

	function openDrawer() {
		drawer?.classList.remove("translate-x-full");
		backdrop?.classList.remove("opacity-0", "pointer-events-none");
		backdrop?.classList.add("opacity-100");
	}

	function closeDrawer() {
		drawer?.classList.add("translate-x-full");
		backdrop?.classList.add("opacity-0", "pointer-events-none");
		backdrop?.classList.remove("opacity-100");
	}

	openBtn?.addEventListener("click", openDrawer);
	closeBtn?.addEventListener("click", closeDrawer);
	backdrop?.addEventListener("click", closeDrawer);

	// Close drawer when a TOC link is clicked on mobile
	drawer?.querySelectorAll("a[data-toc-link]").forEach((link) => {
		link.addEventListener("click", closeDrawer);
	});

	// Active section highlighting via IntersectionObserver
	const tocLinks = document.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]");
	if (tocLinks.length > 0) {
		const slugs = Array.from(tocLinks).map((l) => l.dataset.tocLink!);
		const headingEls = slugs
			.map((slug) => document.getElementById(slug))
			.filter(Boolean) as HTMLElement[];

		let activeSlug = "";

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						activeSlug = entry.target.id;
					}
				}
				tocLinks.forEach((link) => {
					link.classList.toggle("active", link.dataset.tocLink === activeSlug);
				});
			},
			{ rootMargin: "0px 0px -60% 0px", threshold: 0 },
		);

		headingEls.forEach((el) => observer.observe(el));
	}
</script>
