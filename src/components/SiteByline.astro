---
/**
 * Masthead byline. The point is that the reader registers whose takes these
 * are, so the name carries a heavier Roboto Flex weight and the brand text
 * shade while the rest of the line stays quiet metadata.
 */
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<p
	class:list={[
		'm3-label-medium uppercase tracking-widest text-black dark:text-white flex items-baseline gap-x-2 gap-y-1 flex-wrap',
		className,
	]}
>
	<span class="byline-kicker">By</span>
	<a href="/about" class="byline-name hover:underline underline-offset-4"
		><span class="mark-under mark-pink">Vajahath</span></a
	>
	<!-- divider stays glued to the tagline so it never wraps alone -->
	<span>
		<span aria-hidden="true" class="byline-kicker">//</span> Late discoveries
		&amp; probably wrong takes
	</span>
</p>
