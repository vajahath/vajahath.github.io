---
import { getVisiblePosts } from "../lib/content";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/";

const posts = await getVisiblePosts();
const allHotTakes = posts
	.filter((p) => p.data.hotTakes && p.data.hotTakes.length > 0)
	.flatMap((p) => {
		const takes = p.data.hotTakes || [];
		return takes.map((take) => ({
			text: take,
			postId: p.id,
		}));
	});

const randomHotTake =
	allHotTakes.length > 0
		? allHotTakes[Math.floor(Math.random() * allHotTakes.length)]
		: { text: "Faint signals detected in the deep noise...", postId: "" };

// Elsewhere the page supplies its own <h1>, so the wordmark steps down to
// avoid a second top-level heading.
const Wordmark = isHome ? 'h1' : 'div';
import SiteByline from './SiteByline.astro';
import HalftoneField from './HalftoneField.astro';
---

{/* Top Utility & Ticker Row */}
<div
	class="bg-black text-white dark:bg-zinc-900 border-b border-gray-800 flex items-stretch"
>
	<div
		class="flex-1 flex items-center gap-4 px-4 py-2 overflow-hidden border-r border-gray-800"
	>
		<span
			class="m3-label-medium bg-signal-fill px-1.5 py-0.5 shrink-0 text-white font-black"
		>
			{">>>"}
		</span>
		<div
			class="m3-label-medium whitespace-nowrap overflow-hidden flex-1 flex items-center"
		>
			<a
				href={randomHotTake.postId
					? `/blog/${randomHotTake.postId}/`
					: "#"}
				class="flex items-center gap-4 max-w-full opacity-0 hover:text-signal-text transition-colors animate-ticker-entry"
			>
				<span class="truncate">{randomHotTake.text}</span>
				<span
					class="shrink-0 font-black text-[10px] tracking-[0.2em] uppercase bg-white/10 px-1.5 py-0.5"
					>Read More</span
				>
			</a>
		</div>
	</div>
	<button
		id="theme-toggle"
		class="m3-touch-target px-4 m3-label-medium hover:bg-white hover:text-black dark:hover:bg-white dark:hover:text-black transition-all shrink-0 cursor-pointer border-l border-gray-800 uppercase tracking-widest"
	>
		Theme
	</button>
</div>

{/* Main Header */}
<header
	class:list={[
		/* Zone-boundary weight, matching the rule under the spotlight. The page
		   runs two tiers: this for the end of a section, a lighter hairline for
		   one item to the next. */
		"relative overflow-hidden max-w-7xl mx-auto px-4 border-b border-black/30 dark:border-white/30",
		isHome ? "pt-6 pb-5 md:pt-10 md:pb-6" : "py-4",
	]}
>
	<div class="relative flex flex-col gap-2">
		<div
			class="flex flex-col md:flex-row md:items-baseline justify-between gap-4"
		>
			<a href="/" class="relative hover:opacity-90 transition-opacity block">
				<HalftoneField
					class:list={[
						/* Room is taken upward and rightward only. The byline
						   sits 4px under the wordmark, and small orange text
						   over a saturated dot fails AA at any strength worth
						   seeing — so the field stops at the wordmark's foot. */
						"absolute -top-8 -bottom-1 -left-7",
						isHome
							? "-right-10 sm:-right-40 md:-right-64"
							: "-right-8 sm:-right-40",
					]}
					cell={isHome ? 12 : 9}
					fade={isHome ? 'blob' : 'blob-alt'}
					opacity={isHome ? 70 : 60}
					reveal={isHome ? 'ripple' : 'fade'}
					origin="14% 62%"
				/>
				<Wordmark
					class:list={[
						"uppercase italic leading-none m-0 p-0",
						isHome ? "m3-display-large" : "m3-headline-large",
					]}
					style={isHome
						? "font-size: clamp(2.5rem, 11.5vw, 5.5rem);"
						: ""}
				>
					<span class="relative">{SITE_TITLE}</span>
				</Wordmark>
			</a>

			{
				isHome && (
					<SiteByline class="block md:hidden" />
				)
			}

			<nav
				class="flex flex-wrap gap-x-5 gap-y-2 m3-label-large text-black/70 dark:text-white/70 md:pb-1"
			>
				<HeaderLink href="/tags/devlog">DEVLOG</HeaderLink>
				<HeaderLink href="/tags/design">DESIGN</HeaderLink>
				<HeaderLink href="/tags/case-study">CASE STUDY</HeaderLink>
				<HeaderLink href="/tags">ALL TAGS</HeaderLink>
			</nav>
		</div>
		{
			isHome && (
				<SiteByline class="shrink-0 hidden md:flex" />
			)
		}
	</div>
</header>

<style>
	@keyframes tickerSlideUp {
		from {
			transform: translateY(100%);
			opacity: 0;
		}
		to {
			transform: translateY(0.5px);
			opacity: 0.9;
		}
	}

	.animate-ticker-entry {
		animation: tickerSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: 1s;
	}
</style>

<script is:inline>
	function themeToggle() {
		const btn = document.getElementById("theme-toggle");
		const element = document.documentElement;

		function getTheme() {
			return localStorage.getItem("theme") || "auto";
		}

		function updateUI(theme) {
			if (btn) btn.textContent = theme;

			if (theme === "auto") {
				const isDark = window.matchMedia(
					"(prefers-color-scheme: dark)"
				).matches;
				element.classList.toggle("dark", isDark);
			} else {
				element.classList.toggle("dark", theme === "dark");
			}
		}

		// Initial UI sync
		updateUI(getTheme());

		if (btn) {
			btn.addEventListener("click", () => {
				const current = getTheme();
				let next;

				if (current === "auto") next = "light";
				else if (current === "light") next = "dark";
				else next = "auto";

				if (next === "auto") {
					localStorage.removeItem("theme");
				} else {
					localStorage.setItem("theme", next);
				}

				updateUI(next);
			});
		}

		// Watch for system changes when in auto mode
		window
			.matchMedia("(prefers-color-scheme: dark)")
			.addEventListener("change", (e) => {
				if (getTheme() === "auto") {
					element.classList.toggle("dark", e.matches);
				}
			});
	}
	themeToggle();
</script>
