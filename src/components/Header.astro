---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/";

const posts = await getCollection("blog");
const allHotTakes = posts
	.filter((p) => p.data.hotTakes && p.data.hotTakes.length > 0)
	.flatMap((p) => {
		const takes = p.data.hotTakes || [];
		return takes.map((take) => ({
			text: take,
			postId: p.id,
		}));
	});

const randomHotTake =
	allHotTakes.length > 0
		? allHotTakes[Math.floor(Math.random() * allHotTakes.length)]
		: { text: "Faint signals detected in the deep noise...", postId: "" };
---

{/* Top Utility & Ticker Row */}
<div
	class="bg-black text-white dark:bg-zinc-900 border-b border-gray-800 flex items-stretch"
>
	<div
		class="flex-1 flex items-center gap-4 px-4 py-2 overflow-hidden border-r border-gray-800"
	>
		<span
			class="m3-label-medium bg-live-red px-1.5 py-0.5 shrink-0 text-white font-black"
		>
			{">>>"}
		</span>
		<div
			class="m3-label-medium whitespace-nowrap overflow-hidden flex-1 flex items-center"
		>
			<a
				href={randomHotTake.postId
					? `/blog/${randomHotTake.postId}/`
					: "#"}
				class="flex items-center gap-4 max-w-full opacity-0 hover:text-live-red transition-colors animate-ticker-entry"
			>
				<span class="truncate">{randomHotTake.text}</span>
				<span
					class="shrink-0 font-black text-[10px] tracking-[0.2em] uppercase bg-white/10 px-1.5 py-0.5"
					>Read More</span
				>
			</a>
		</div>
	</div>
	<button
		id="theme-toggle"
		class="m3-touch-target px-4 m3-label-medium hover:bg-white hover:text-black dark:hover:bg-white dark:hover:text-black transition-all shrink-0 cursor-pointer border-l border-gray-800 uppercase tracking-widest"
	>
		Theme
	</button>
</div>

{/* Main Header */}
<header
	class:list={[
		"max-w-7xl mx-auto px-4 border-b-2 border-black dark:border-white",
		isHome ? "pt-10 pb-6" : "py-4",
	]}
>
	<div class="flex flex-col gap-2">
		<div
			class="flex flex-col md:flex-row md:items-baseline justify-between gap-4"
		>
			<a href="/" class="hover:opacity-90 transition-opacity block">
				<h1
					class:list={[
						"italic leading-none m-0 p-0",
						isHome ? "m3-display-large" : "m3-headline-large",
					]}
					style={isHome
						? "font-size: clamp(3.2rem, 9vw, 5.5rem);"
						: ""}
				>
					{SITE_TITLE}
				</h1>
			</a>

			{
				isHome && (
					<p class="m3-label-medium text-black dark:text-white uppercase tracking-widest block md:hidden">
						Vajahath's Signal Feed // Late Discoveries & Probably Wrong Takes
					</p>
				)
			}

			<nav
				class="flex flex-wrap gap-x-6 gap-y-2 m3-label-large text-black dark:text-white md:pb-1"
			>
				<HeaderLink href="/tags/ai-&-tech">AI & TECH</HeaderLink>
				<HeaderLink href="/tags/travel">TRAVEL</HeaderLink>
				<HeaderLink href="/tags/personal-blog">BLOG</HeaderLink>
				<HeaderLink href="/tags">ALL TAGS</HeaderLink>
			</nav>
		</div>
		{
			isHome && (
				<p class="m3-label-medium text-black dark:text-white uppercase tracking-widest shrink-0 hidden md:block">
					Vajahath's Signal Feed // Late Discoveries & Probably Wrong Takes
				</p>
			)
		}
	</div>
</header>

<style>
	@keyframes tickerSlideUp {
		from {
			transform: translateY(100%);
			opacity: 0;
		}
		to {
			transform: translateY(0.5px);
			opacity: 0.9;
		}
	}

	.animate-ticker-entry {
		animation: tickerSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: 1s;
	}
</style>

<script is:inline>
	function themeToggle() {
		const btn = document.getElementById("theme-toggle");
		const element = document.documentElement;

		function getTheme() {
			return localStorage.getItem("theme") || "auto";
		}

		function updateUI(theme) {
			if (btn) btn.textContent = theme;

			if (theme === "auto") {
				const isDark = window.matchMedia(
					"(prefers-color-scheme: dark)"
				).matches;
				element.classList.toggle("dark", isDark);
			} else {
				element.classList.toggle("dark", theme === "dark");
			}
		}

		// Initial UI sync
		updateUI(getTheme());

		if (btn) {
			btn.addEventListener("click", () => {
				const current = getTheme();
				let next;

				if (current === "auto") next = "light";
				else if (current === "light") next = "dark";
				else next = "auto";

				if (next === "auto") {
					localStorage.removeItem("theme");
				} else {
					localStorage.setItem("theme", next);
				}

				updateUI(next);
			});
		}

		// Watch for system changes when in auto mode
		window
			.matchMedia("(prefers-color-scheme: dark)")
			.addEventListener("change", (e) => {
				if (getTheme() === "auto") {
					element.classList.toggle("dark", e.matches);
				}
			});
	}
	themeToggle();
</script>
