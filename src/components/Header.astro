---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/";
---

{/* Top Utility & Ticker Row */}
<div
	class="bg-black text-white dark:bg-zinc-900 border-b border-gray-800 flex items-stretch"
>
	<div
		class="flex-1 flex items-center gap-4 px-4 py-2 overflow-hidden border-r border-gray-800"
	>
		<span
			class="m3-label-medium bg-live-red px-1.5 py-0.5 shrink-0 text-white"
		>
			Ticker
		</span>
		<div
			class="m3-label-medium whitespace-nowrap overflow-hidden relative w-full h-4"
		>
			<p class="absolute animate-marquee opacity-90">
				Solar energy adoption hits record high in northern sectors • New
				fashion collection merges code with couture • Gaming communities
				shift to decentralized hosting • Faint signals detected in the
				deep noise...
			</p>
		</div>
	</div>
	<button
		id="theme-toggle"
		class="m3-touch-target px-4 m3-label-medium hover:bg-white hover:text-black dark:hover:bg-white dark:hover:text-black transition-all shrink-0 cursor-pointer border-l border-gray-800 uppercase tracking-widest"
	>
		Theme
	</button>
</div>

{/* Main Header */}
<header
	class:list={[
		"max-w-7xl mx-auto px-4 border-b-2 border-black dark:border-white",
		isHome ? "pt-10 pb-6" : "py-4",
	]}
>
	<div class="flex flex-col gap-2">
		<div
			class="flex flex-col md:flex-row md:items-baseline justify-between gap-4"
		>
			<a href="/" class="hover:opacity-90 transition-opacity block">
				<h1
					class:list={[
						"italic leading-none m-0 p-0",
						isHome ? "m3-display-large" : "m3-headline-large",
					]}
					style={isHome
						? "font-size: clamp(3.2rem, 9vw, 5.5rem);"
						: ""}
				>
					{SITE_TITLE}
				</h1>
			</a>
			<nav
				class="flex flex-wrap gap-x-6 gap-y-2 m3-label-large text-black dark:text-white md:pb-1"
			>
				<HeaderLink href="/" class="hover:underline text-brand-blue"
					>Technology</HeaderLink
				>
				<HeaderLink href="/blog" class="hover:underline"
					>Solar</HeaderLink
				>
				<HeaderLink href="/about" class="hover:underline"
					>Gaming</HeaderLink
				>
				<a href="#" class="hover:underline">Design</a>
			</nav>
		</div>
		{
			isHome && (
				<p class="m3-label-medium text-gray-500 dark:text-gray-400 uppercase tracking-widest shrink-0">
					Late Discoveries & Probably Wrong Takes
				</p>
			)
		}
	</div>
</header>

<style>
	@keyframes marquee {
		0% {
			transform: translateX(100%);
		}
		100% {
			transform: translateX(-100%);
		}
	}
	.animate-marquee {
		animation: marquee 30s linear infinite;
	}
</style>

<script is:inline>
	function themeToggle() {
		const btn = document.getElementById("theme-toggle");
		if (btn) {
			btn.addEventListener("click", () => {
				const element = document.documentElement;
				element.classList.toggle("dark");
				const isDark = element.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			});
		}
	}
	themeToggle();
</script>
