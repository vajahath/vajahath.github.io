---
/**
 * A halftone dot screen over a colour gradient, used as atmosphere behind
 * content. Two nested elements on purpose: the outer one carries the falloff,
 * the inner one the dot mask. One mask per element composites reliably in
 * every browser; stacking both on one element needs mask-composite, which
 * does not.
 *
 * Nothing here animates, deliberately. A field this size is one of the largest
 * LCP candidates on the page — a background image counts, and on the home page
 * this measures 110k px² against the headline's 132k. Anything that fades it
 * in from zero records its paint when it finishes, so on a page with a shorter
 * headline the field would win LCP and drag it out to the length of the
 * animation. Painting with everything else costs nothing and cannot regress.
 *
 * Always decorative. It never sits behind text small enough for a saturated
 * dot to cost contrast.
 */
interface Props {
	class?: string;
	/** Dot pitch. Larger reads as coarser, more printed. */
	cell?: number;
	/** How the screen thins out at its edges. Irregular by default: a clean
	 *  oval, or an edge squared off by a container, reads as a placed graphic
	 *  rather than something scattered. */
	fade?: 'blob' | 'blob-alt' | 'none';
	/** Degrees to rotate the spectrum, so repeated fields are not identical. */
	hue?: number;
	/** 0–100. Kept low wherever text sits nearby. */
	opacity?: number;
}
const {
	class: className = '',
	cell = 11,
	fade = 'blob',
	hue = 0,
	opacity = 100,
} = Astro.props;

const fadeClass = {
	blob: 'halftone-fade-blob',
	'blob-alt': 'halftone-fade-blob-alt',
	none: '',
}[fade];

// Injected with set:html rather than written as children: inside an Astro
// expression the braces in this source are parsed as JSX, and the script ships
// wrapped in its own template literal and silently does nothing.
const reroll = `(function(){var s=document.currentScript,e=s&&s.previousElementSibling;` +
	`if(!e||!e.hasAttribute("data-halftone-blob"))return;` +
	`function r(a,b){return (a+Math.random()*(b-a)).toFixed(1)}` +
	`var n=3+Math.floor(Math.random()*3),g=[],i;` +
	`for(i=0;i<n;i++)g.push("radial-gradient(ellipse "+r(18,34)+"% "+r(20,36)+"% at "+` +
	`r(26,72)+"% "+r(24,70)+"%, #000 "+r(2,9)+"%, transparent "+r(62,72)+"%)");` +
	`var v=g.join(",");e.style.maskImage=v;e.style.webkitMaskImage=v})();`;
---

<div
	class:list={['pointer-events-none overflow-hidden', fadeClass, className]}
	aria-hidden="true"
	data-halftone-blob={fade === 'none' ? undefined : ''}
	style={`opacity: ${opacity / 100};`}
>
	<div
		class="halftone w-full h-full"
		style={`--halftone-cell: ${cell}px;${hue ? ` filter: hue-rotate(${hue}deg);` : ''}`}
	>
	</div>
</div>

{/*
  Re-rolls this field's falloff so the scatter is never the shape you saw last
  time. Inline and adjacent on purpose: it runs during parse, so the shape is
  right at first paint and there is no swap to hide — which is what let the
  reveal animation go. A bundled module would run after parse and pop.

  Lobe centres stay between 26% and 72% with radii capped at 34%, so the
  furthest a lobe reaches is 89%: the blob always finishes fading before its
  container clips it. A lobe cut off by the clip is a straight edge, which is
  the one thing this must never have.

  With JavaScript off the CSS shape stands in, so the texture is never absent,
  only less varied.
*/}
{fade !== 'none' && <script is:inline set:html={reroll} />}
